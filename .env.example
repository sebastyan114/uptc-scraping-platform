APP_NAME=UPTC Scraping Platform API
APP_VERSION=0.1.0
APP_ENV=development

BACKEND_PORT=8000


POSTGRES_DB=websec
POSTGRES_USER=websec_user
POSTGRES_PASSWORD=websec_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://websec_user:websec_password@postgres:5432/websec

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=analysis_embeddings
QDRANT_PORT=6333
QDRANT_METRICS_PORT=6334

MAX_REQUESTS_PER_SECOND=1.0
TARGET_TIMEOUT_SECONDS=10